# --- Local install sandboxes: fresh-project simulations under sandbox/ ---
# Each subfolder is its own git-init'ed throwaway project where BMAD + the
# auto-gds custom module get installed for smoke testing. Never committed.
sandbox/

# --- Local BMAD test install (kept out of the published plugin repo) ---
# This repo doubles as a dev sandbox: a full BMAD project is installed here so
# the orchestrator can be tested end-to-end. None of it belongs in the plugin.
_bmad/
_bmad-output/
.agents/
# .claude/ is ignored wholesale EXCEPT the one tracked maintainer skill below.
# (Git can't re-include a path under an excluded directory, so ignore the
# contents of each level and re-include the chain down to the skill.)
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/auto-gds-compat-check/
# Generated tool-native delegate agents (rendered by scripts/render-agents.py).
# .claude/* already covers .claude/agents/; .codex/ is the Codex equivalent.
.codex/

# --- OS / editor noise ---
.DS_Store
*.swp
*~
.idea/
.vscode/

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
